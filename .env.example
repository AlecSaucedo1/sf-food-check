# Local development defaults. Production should set USE_LIVE_DATA=1.
USE_LIVE_DATA=0
DATABASE_PATH=./data/inspections.db
DATASF_DATASET_ID=tvy3-wexg
DATASF_BASE_URL=https://data.sfgov.org/resource
SOCRATA_APP_TOKEN=

# Production data refresh. With a single SQLite-backed instance, the application
# can safely refresh the DataSF snapshot in-process.
LIVE_SYNC_ON_START=1
SYNC_BACKGROUND=0
SYNC_INTERVAL_HOURS=24

# Optional. Keep blank until a stable, permitted report-enrichment method is implemented.
MHD_BASE_URL=https://inspections.myhealthdepartment.com/san-francisco
